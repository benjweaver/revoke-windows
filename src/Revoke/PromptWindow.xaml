<Window
    x:Class="Revoke.PromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Revoke">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <StackPanel x:Name="Root" Padding="24,20,24,20" Spacing="12">
    <TextBlock x:Name="HeaderText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />

    <TextBox x:Name="DetailBox"
             IsReadOnly="True"
             TextWrapping="Wrap"
             AcceptsReturn="True"
             FontFamily="Consolas"
             FontSize="12"
             MaxHeight="220"
             ScrollViewer.VerticalScrollBarVisibility="Visible"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Visibility="Collapsed" />

    <TextBlock x:Name="BodyText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />

    <TextBlock x:Name="QuestionText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
      <Button x:Name="NoButton" Content="No" MinWidth="84" Click="No_Click" />
      <Button x:Name="YesButton" Content="Yes" MinWidth="84" Click="Yes_Click" />
    </StackPanel>
  </StackPanel>
</Window>
