<Window
    x:Class="Revoke.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Revoke">
  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" Width="720" Padding="16" RowSpacing="12" KeyDown="Root_KeyDown">
    <Grid.Resources>
      <!-- Switches are orange while access is on, as in Revoke for macOS: on means exposed. -->
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#F7630C" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF7A2B" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#E15A0B" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#F7630C" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF7A2B" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#E15A0B" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White" />
      <!-- Just the switch: no On/Off label beside it. -->
      <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
      <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
      <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Revoke" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock x:Name="Status" Text="Reading…" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource SubtleButtonStyle}"
              Click="Settings_Click" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
        <FontIcon Glyph="&#xE713;" FontSize="16" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar x:Name="HelperNotice" Severity="Error" IsClosable="False">
        <InfoBar.ActionButton>
          <Button x:Name="HelperNoticeButton" Click="HelperNotice_Click" />
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar x:Name="FirewallNotice" Severity="Warning" IsClosable="False"
               Message="Revoke can't read the firewall rules, so the Local network column may be wrong." />
    </StackPanel>

    <Grid x:Name="Columns" Grid.Row="2" Padding="8,0" />

    <ScrollViewer Grid.Row="3" MaxHeight="440" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="List" Spacing="2" />
    </ScrollViewer>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
      <Button x:Name="RevokeAll" Content="Revoke all watched" Style="{StaticResource AccentButtonStyle}" Click="RevokeAll_Click"
              ToolTipService.ToolTip="Switch off every switch the watched apps have, Links included, and stop them. Services and firewall rules ask for admin, unless the helper is installed." />
      <Button x:Name="EndAll" Content="End all tasks" Click="EndAll_Click"
              ToolTipService.ToolTip="Stop every watched app, everything they started, and their services. Other switches stay as they are." />
      <ProgressRing x:Name="Spinner" Width="16" Height="16" IsActive="False" />
      <TextBlock x:Name="Activity" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <TextBlock Grid.Row="5" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
               x:Name="Footnote" />
  </Grid>
</Window>
