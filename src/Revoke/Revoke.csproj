<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Revoke</RootNamespace>
    <AssemblyName>Revoke</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Without it, publishing leaves out Revoke.pri and the compiled XAML, and the app
         crashes on start. It adds no MSIX packaging to an app that isn't packaged. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Revoke</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Revoke.Core\Revoke.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The helper ships beside Revoke.exe as one self-contained file, which installing
       it from Settings copies into Program Files. -->
  <Target Name="PublishHelperToOutput" AfterTargets="Build">
    <MSBuild Projects="..\Revoke.Helper\Revoke.Helper.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=$(Platform);PublishDir=$(TargetDir)Helper\" />
  </Target>
  <Target Name="PublishHelperToPublishDir" AfterTargets="Publish">
    <MSBuild Projects="..\Revoke.Helper\Revoke.Helper.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=$(Platform);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)'))Helper\" />
  </Target>
</Project>
